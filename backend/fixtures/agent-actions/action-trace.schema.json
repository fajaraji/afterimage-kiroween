{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Afterimage optional synthetic action trace example",
  "description": "Illustrative contract; not evidence that any AWS/agent gateway executed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "illustrativeOnly",
    "runId",
    "intent",
    "policyDecision",
    "executionReceipt",
    "postActionObservation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 90
    },
    "illustrativeOnly": {
      "const": true
    },
    "runId": {
      "type": "string",
      "pattern": "^synthetic-"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "actorKind",
        "operation",
        "target",
        "payloadDigest"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "minLength": 1
        },
        "actorKind": {
          "enum": [
            "scenario-runner",
            "simulated-agent"
          ]
        },
        "operation": {
          "enum": [
            "READ_SYNTHETIC_RECORD",
            "DELETE_SYNTHETIC_RECORD",
            "DROP_SYNTHETIC_TABLE_PROPOSAL"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^synthetic-"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "policyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "outcome",
        "ruleId"
      ],
      "properties": {
        "decisionId": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ALLOW",
            "DENY",
            "REQUIRE_APPROVAL"
          ]
        },
        "ruleId": {
          "type": "string"
        }
      }
    },
    "executionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_EXECUTED",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "executionId": {
          "type": "string"
        }
      }
    },
    "postActionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidenceId",
        "source"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "ABSENT",
            "UNKNOWN"
          ]
        },
        "evidenceId": {
          "type": "string"
        },
        "source": {
          "enum": [
            "illustrative-independent-verifier"
          ]
        },
        "errorCode": {
          "type": "string"
        }
      }
    }
  }
}
