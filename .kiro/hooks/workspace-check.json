{
  "version": "v1",
  "hooks": [
    {
      "name": "Validate workspace structure on source save",
      "trigger": "PostFileSave",
      "matcher": "^backend/(apps|packages)/.*\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "node backend/scripts/validate-workspace.mjs --quiet"
      }
    }
  ]
}
